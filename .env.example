# =============================================================
# MPLADS Sentinel — Root Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================

# ----- PostgreSQL -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mplads_sentinel
POSTGRES_USER=sentinel_user
POSTGRES_PASSWORD=SentinelDB@2026!

# ----- Spring Boot -----
BACKEND_PORT=8080
JWT_SECRET=mplads-sentinel-jwt-secret-change-in-production-min-256-bits
JWT_EXPIRY_MS=86400000

# ----- Python ML Service -----
ML_SERVICE_PORT=8000
ML_SERVICE_URL=http://localhost:8000

# ----- Application Mode -----
# Set to "demo" to enable DEMO DATA MODE banner
APP_MODE=demo

# ----- Optional: LLM (for natural language search only) -----
# Leave blank — core system works without an LLM
LLM_API_KEY=
LLM_PROVIDER=none
